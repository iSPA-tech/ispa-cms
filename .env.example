MASTER_USERNAME=
MASTER_PASSWORD=
DEFAULT_GUEST_ROLE_ID=3

CMS_SETTING_RUNTIME_ENABLED=true

MAINTENANCE_ENABLE=false
HOMEPAGE_TYPE="default"
HOMEPAGE_STATIC_ID="2"

ISPA_API_AUTH_KEY=
ISPA_ADMIN_AUTH_KEY=

VITE_TEMPLATE_FOLDER=Default
CMS_DOMAIN=
CMS_DOMAIN_SECRET=

APP_NAME="iSPA CMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_DOMAIN=localhost
FE_DOMAIN=
INDEX_NOW_KEY=

# HTTPS for production & staging, HTTP for local & testing
APP_URL="http://${APP_DOMAIN}"

# WebAuthn / passkeys. Use a trusted RP domain shared by the admin and public origins.
PASSKEYS_RP_ID="${APP_DOMAIN}"
PASSKEYS_ALLOWED_ORIGINS="${APP_URL}"
PASSKEYS_USER_HANDLE_SECRET="${APP_KEY}"
PASSKEYS_CHALLENGE_TTL=300

ASSET_URL="${APP_URL}"
SESSION_DOMAIN=".${APP_DOMAIN}"
SANCTUM_STATEFUL_DOMAINS=".${APP_DOMAIN}"
PUBLIC_PATH=public
DEFAULT_LOCALE=vi

# This config only use for development
VITE_TEMPLATE_VIEWS_PATH="projects/${VITE_TEMPLATE_FOLDER}/views/"
VITE_TEMPLATE_TAILWIND_CSS="projects/${VITE_TEMPLATE_FOLDER}/dev/theme.css"
VITE_TEMPLATE_TAILWIND_CONFIG="projects/${VITE_TEMPLATE_FOLDER}/dev/tailwind.config.js"
VITE_TEMPLATE_TAILWIND_OUTPUT="public/${VITE_TEMPLATE_FOLDER}/assets/css"

TIMEZONE=Asia/Ho_Chi_Minh
# API Section
GOOGLE_API=
# Optional SOCKS5 proxy for image downloads from hosts that block the server, e.g. socks5h://127.0.0.1:1080.
IMAGE_PROXY_SOCKS5=
# Outside production only: IP used for visitor geolocation instead of the local request IP.
LOCATION_FALLBACK_IP=
GOOGLE_VISION_API_KEY=
SALE_HUNTING_ACCESSTRADE_API_KEY=
SALE_HUNTING_ACCESSTRADE_SITE_ID=
SALE_HUNTING_ACCESSTRADE_BASE_URL=https://api.accesstrade.vn
SALE_HUNTING_ACCESSTRADE_TIMEOUT=20
SALE_HUNTING_ACCESSTRADE_HOT_LIMIT=30
SALE_HUNTING_ACCESSTRADE_HOT_DATE=1
SALE_HUNTING_ACCESSTRADE_USER_AGENT=PostmanRuntime/7.45.0
SALE_HUNTING_PUB2_JWT=
SALE_HUNTING_PUB2_EMAIL=
SALE_HUNTING_PUB2_PASSWORD=
SALE_HUNTING_PUB2_BASE_URL=https://pub2-api.accesstrade.vn
SALE_HUNTING_PUB2_TIMEOUT=20
SALE_HUNTING_PUB2_LIMIT=30
SALE_HUNTING_PUB2_LOGIN_URL=https://pub2.accesstrade.vn/login
SALE_HUNTING_PUB2_PRODUCT_FEEDS_URL=https://pub2.accesstrade.vn/tool/product-feeds
SALE_HUNTING_PUB2_STORAGE_STATE=
SALE_HUNTING_PUB2_NODE_BINARY=node
SALE_HUNTING_PUB2_HEADLESS=true
SALE_HUNTING_PUB2_PRODUCT_FEEDS_TIMEOUT=90
SALE_HUNTING_AUTOPILOT_ENABLED=false
SALE_HUNTING_AUTOPILOT_CAMPAIGN_LIMIT=50
SALE_HUNTING_AUTOPILOT_COUPON_LIMIT=30
SALE_HUNTING_AUTOPILOT_LINK_LIMIT=50
SALE_HUNTING_AUTOPILOT_MINIMUM_SCORE=90
SMART_LIBRARY_DB_CONNECTION=pgsql
TELESCOPE_ENABLED=true
# Comma-separated e-mails that may open Telescope outside APP_ENV=local (empty = nobody).
TELESCOPE_ALLOWED_EMAILS=

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Default local database remains MySQL/MariaDB.
# Switch DB_CONNECTION=pgsql for PostgreSQL. The pgsql connection reads PTG_* first,
# then DB_* fallback. For host-local PostgreSQL tests, set both groups to the same DB.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ispa_cms
DB_USERNAME=root
DB_PASSWORD=
DB_TESTING_DATABASE=ispa_cms_testing

# PostgreSQL dev database values.
PTG_HOST=127.0.0.1
PTG_PORT=5432
PTG_DATABASE=ispa_cms
PTG_USERNAME=postgres
# PTG_PASSWORD= (leave unset to reuse DB_PASSWORD)
PTG_SEARCH_PATH=public
PTG_SSLMODE=prefer

# Uncomment when the PHP container should install PostgreSQL extensions for local Docker dev.
# INSTALL_PGSQL=1
# COMPOSE_PROFILES=pgsql

# AGENTIC_EMBEDDING_PROVIDER_DRIVER=null

SOCIAL_AUTH_GOOGLE_CLIENT_IDS=
SOCIAL_AUTH_GOOGLE_CLIENT_ID=
SOCIAL_AUTH_GOOGLE_REDIRECT_URI=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
CACHE_ENABLE=false
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
# Seconds before a database/beanstalkd queue job is retried; raise for long module installs (Redis uses REDIS_QUEUE_RETRY_AFTER).
QUEUE_RETRY_AFTER=90
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_ENABLE=false
REDIS_CLIENT=predis
TRACKING_REDIS_COUNTER_ENABLED=false
TRACKING_REDIS_COUNTER_CONNECTION=tracking
TRACKING_REDIS_COUNTER_PREFIX=tracking:buffer
TRACKING_REDIS_COUNTER_REQUIRE_AOF=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_TRACKING_DB=2
REDIS_PREFIX=
REDIS_USERNAME=default
REDIS_PASSWORD=

MAIL_ENABLE=true
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare R2 disk (S3 compatible); set the endpoint and public URL only when you use it
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_DEFAULT_REGION=auto
R2_BUCKET=
R2_USE_PATH_STYLE_ENDPOINT=false
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_URL=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

LOG_SLACK_WEBHOOK_URL=
