  public function updating({{ name }} $model): void
  {
     $this->updateDateTime($model);
    //  Get changed data
    $changed = AppHelpers::getChanges($model);
    //  Fire AuditLog
    if(!isset($changed['from']['deleted_at'])) {
      event(new AuditLog('update', $changed, get_class($model), $model->id, 'fa fa-edit', 'primary', auth()->id()));
    }
  }

