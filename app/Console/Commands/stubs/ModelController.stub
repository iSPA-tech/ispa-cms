  /**
   * Fill table
   *-------------------
   * @param null $model
   * @return Mixed $model
   *
   **@author malayvuong
  */
  protected function fill($model = null)
  {
    if (!$model) {
      $model = $this->model->model();
    }

    $model->fill(request()->only($model->getFillable()));

    return $model;
  }
