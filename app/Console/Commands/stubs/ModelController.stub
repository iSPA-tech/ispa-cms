  public function update(Request $request, {{ name }}Interface $model)
  {
    if ($id < 1) {
      return ires()->error()->message(__('mgs.model.404'));
    }

    $model = $this->model->find($id);

    if (!$model) {
      return ires()->error()->message(__('mgs.model.404'));
