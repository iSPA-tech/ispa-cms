{
    "name": "ispa-tech/ispa-cms",
    "type": "project",
    "description": "iSPA CMS - iSPA Team",
    "homepage": "https://ispa.tech",
    "support": {
        "docs": "https://docs.ispa.tech",
        "issues": "https://github.com/iSPA-tech/ispa-cms/issues",
        "source": "https://github.com/iSPA-tech/ispa-cms"
    },
    "keywords": [
        "cms",
        "ispa",
        "ispa-cms"
    ],
    "license": "AGPL-3.0-only",
    "require": {
        "php": "^8.3",
        "barryvdh/laravel-dompdf": "^3.1",
        "guzzlehttp/guzzle": "^7.8",
        "intervention/image": "^3.2",
        "jenssegers/agent": "^2.6",
        "laravel/framework": "^13.0",
        "laravel/passkeys": "^0.2.1",
        "laravel/sail": "*",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.6",
        "laravel/telescope": "^5.0",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.35",
        "league/flysystem-sftp-v3": "^3.36",
        "league/flysystem-webdav": "^3.31",
        "nesbot/carbon": "3.11.4",
        "nwidart/laravel-modules": "^13.0",
        "openai-php/laravel": "^0.19.1",
        "php-webdriver/webdriver": "^1.15",
        "phpoffice/phpspreadsheet": "^5.4",
        "predis/predis": "^2.2",
        "simplesoftwareio/simple-qrcode": "^4.2",
        "spatie/laravel-ignition": "*",
        "stevebauman/location": "*",
        "stripe/stripe-php": "^12.0",
        "symfony/dom-crawler": "^7.1",
        "symfony/expression-language": "^7.4",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "pestphp/pest": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "PJ\\": "projects/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/common.php",
            "app/Helpers/helpers.php",
            "app/Helpers/SeoHelpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump-after-optimization": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php -r \"if (!getenv('SKIP_LARAVEL_ASSETS')) passthru('php artisan vendor:publish --tag=laravel-assets --ansi --force'); else echo 'Skipping laravel-assets publish (SKIP_LARAVEL_ASSETS set).' . PHP_EOL;\""
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"echo PHP_EOL.'Next: fill the database in .env, run php artisan cms:install, then ./ispa start for development or php artisan serve.'.PHP_EOL;\""
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/telescope"
            ]
        },
        "merge-plugin": {
            "include": [
                "cms/*/composer.json"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "thecodingmachine/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
